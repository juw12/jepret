{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jepret",
  "version": "1.1.0",
  "identifier": "io.github.juw12.jepret",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jepret - camera photos to stock upload files",
        "url": "index.html",
        "width": 1180,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
